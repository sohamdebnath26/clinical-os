# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Optional comma-separated pool of Gemini keys for automatic round-robin load balancing & 429 failover.
GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Optional ultra-fast LLM inference API key for instant clinical note parsing and summaries (<250ms latency).
GROQ_API_KEY=""

# GROQ_API_KEYS: Optional comma-separated pool of Groq API keys for round-robin load balancing & 429 failover.
GROQ_API_KEYS=""

# DATABASE_URL: Supabase PostgreSQL connection string for persistent cloud sync & normalized media storage.
DATABASE_URL=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional Supabase Storage credentials for offloading clinical photos & PDFs to a 100GB+ object bucket.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="clinical-media"

